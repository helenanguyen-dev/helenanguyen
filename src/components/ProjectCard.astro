---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../lib/url';
import BrandLockup from './BrandLockup.astro';
interface Props {
  slug: string; title: string; cover?: ImageMetadata; coverAlt?: string;
  tileBg: string; tileStyle: 'browser' | 'phone' | 'logo' | 'photo'; tileImage?: ImageMetadata; tileText?: string; tileRound?: boolean; tileLogo?: ImageMetadata; tileLogoPartner?: ImageMetadata;
  role?: string; year?: string;
}
const { slug, title, cover, coverAlt, tileBg, tileStyle, tileImage, tileText, tileRound, tileLogo, tileLogoPartner, role, year } = Astro.props;
const meta = [role, year].filter(Boolean).join(' · ');
const img = tileImage ?? cover;
---
<a class="card" href={url(`/work/${slug}/`)}>
  <div class="tile" style={`background: ${tileBg}`}>
    {tileStyle === 'photo' && img ? (
      <div class="photo-stack">
        <Image class="photo" src={img} alt="" width={900} />
        {tileLogo && <BrandLockup class="brand" logo={tileLogo} partner={tileLogoPartner} />}
      </div>
    ) : tileStyle === 'logo' && img ? (
      <div class="logo-stack">
        <div class="logo-lockup">
          <Image class:list={['logo', { round: tileRound }]} src={img} alt="" width={224} height={224} />
          {tileText && <span class="wordmark">{tileText}</span>}
        </div>
        {tileLogo && <BrandLockup class="brand partner-row" logo={tileLogo} partner={tileLogoPartner} />}
      </div>
    ) : tileStyle === 'phone' && img ? (
      <div class="phone-stack">
        <div class="phone" aria-hidden="true">
          <div class="notch"></div>
          <Image class="phone-screen" src={img} alt="" width={480} />
        </div>
        {tileLogo && <BrandLockup class="brand" logo={tileLogo} partner={tileLogoPartner} />}
      </div>
    ) : img && tileLogo ? (
      <div class="browser-stack">
        <div class="browser" aria-hidden="true">
          <div class="bar"><i></i><i></i><i></i></div>
          <Image class="screen" src={img} alt="" width={900} />
        </div>
        <BrandLockup class="brand" logo={tileLogo} partner={tileLogoPartner} />
      </div>
    ) : img ? (
      <div class="browser" aria-hidden="true">
        <div class="bar"><i></i><i></i><i></i></div>
        <Image class="screen" src={img} alt="" width={900} />
      </div>
    ) : (
      <span class="empty">Project image</span>
    )}
  </div>
  {meta && <p class="meta">{meta}</p>}
  <h3>{title}</h3>
</a>
<style>
  .card { display: block; text-decoration: none; color: inherit; }
  .tile { position: relative; aspect-ratio: 4 / 3; overflow: hidden; display: grid; place-items: center; border-radius: 4px; }
  .tile::after { content: ''; position: absolute; inset: 0; background: radial-gradient(120% 80% at 80% 0%, rgba(255,255,255,.18), transparent 60%); pointer-events: none; }
  .browser { width: 74%; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 24px 50px -18px rgba(20, 20, 40, .45); transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .bar { display: flex; gap: 6px; padding: 9px 12px; background: #f1f1f3; border-bottom: 1px solid #e4e4e8; }
  .bar i { width: 8px; height: 8px; border-radius: 50%; background: #d3d3d9; }
  .screen { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }
  .phone { position: relative; height: 84%; aspect-ratio: 9 / 18.5; background: #fff; border: 7px solid #fff; border-radius: 30px; overflow: hidden; box-shadow: 0 0 0 1px rgba(0,0,0,.06), 0 26px 50px -18px rgba(10, 40, 20, .5); transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .notch { position: absolute; top: 6px; left: 50%; transform: translateX(-50%); width: 34%; height: 14px; background: #1c1b19; border-radius: 10px; z-index: 1; }
  .phone-screen { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center; border-radius: 22px; padding-top: 22px; background: #fdfdfd; }
  .phone-stack { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4%; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .phone-stack .phone { flex: none; }
  .phone-stack:has(:global(.brand)) .phone { height: 70%; }
  .phone-stack:not(:has(:global(.brand))) .phone { height: 84%; }
  :global(.brand) { flex: none; width: auto; height: 7%; display: block; position: relative; z-index: 1; }
  .card:hover .phone-stack:has(:global(.brand)) { transform: translateY(-6px) scale(1.02); }
  .card:hover .phone-stack:has(:global(.brand)) .phone { transform: none; }
  .browser-stack { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5%; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  /* Show the whole screenshot: the window takes its height from the tile and its width from the image */
  .tile:has(.browser-stack) { container-type: size; }
  .browser-stack .browser { flex: none; width: fit-content; }
  .browser-stack .screen { height: 60cqh; width: auto; max-width: 80cqw; aspect-ratio: auto; object-fit: contain; }
  .browser-stack :global(.brand) { height: 12%; }
  .logo-stack { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9%; }
  .logo-stack :global(.partner-row) { height: 9%; font-size: clamp(10px, 1.4vw, 16px); opacity: .92; }
  .card:hover .browser-stack { transform: translateY(-6px) scale(1.02); }
  .card:hover .browser-stack .browser { transform: none; }
  .card:hover .phone { transform: translateY(-6px) scale(1.02); }
  .logo-lockup { display: flex; align-items: center; gap: clamp(14px, 2.5vw, 26px); transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .logo { width: clamp(64px, 9vw, 112px); height: auto; border-radius: 22%; box-shadow: 0 18px 40px -16px rgba(10, 20, 60, .5); }
  .logo.round { border-radius: 50%; }
  /* A badge that already carries its name stands alone, larger */
  .logo-lockup:not(:has(.wordmark)) .logo { width: clamp(120px, 19vw, 230px); }
  .wordmark { font-family: var(--font-display); font-weight: 400; font-size: clamp(40px, 6vw, 76px); color: #fff; letter-spacing: -0.01em; }
  .empty { color: rgba(255,255,255,.85); font-size: 14px; }
  .card:hover .browser, .card:hover .logo-lockup { transform: translateY(-6px) scale(1.02); }
  /* Photo tile: a whole event photo, framed like a print and centered */
  .tile:has(.photo-stack) { container-type: size; }
  .photo-stack { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5%; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .photo-stack :global(.photo) { display: block; height: 72cqh; width: auto; max-width: 84cqw; object-fit: contain; border: 6px solid #fff; border-radius: 6px; box-shadow: 0 24px 50px -18px rgba(10, 30, 40, .5); }
  .card:hover .photo-stack { transform: translateY(-6px) scale(1.02); }
  .meta { font-size: 12px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); text-align: center; margin: 20px 0 0; }
  .meta + h3 { margin-top: 8px; }
  h3 { font-family: var(--font-display); font-weight: 300; font-size: clamp(20px, 2.2vw, 26px); text-align: center; margin: 22px 0 0; transition: color .2s; }
  .card:hover h3 { color: var(--accent); }
</style>
