---
import { url } from '../lib/url';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title, description = 'Portfolio of Helena Nguyen, product manager and data analyst.' } = Astro.props;
const pageTitle = title ? `${title} · Helena Nguyen` : 'Helena Nguyen';
const path = Astro.url.pathname;
const site = Astro.site ?? 'https://helenanguyen-dev.github.io';
const ogImage = new URL(url('/og-image.png?v=3'), site).href;
const canonical = new URL(path, site).href;
const nav = [
  { href: '/about/', label: 'About' },
  { href: '/work/', label: 'Work' },
  { href: '/blog/', label: 'Blog' },
  { href: '/contact/', label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Helena Nguyen" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Helena Nguyen, product manager and data analyst" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={url("/favicon.ico?v=3")} sizes="any" />
    <link rel="icon" href={url("/favicon.svg?v=3")} type="image/svg+xml" />
    <link rel="icon" href={url("/favicon-32.png?v=3")} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png?v=3")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,800;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header wrap">
      <a href={url("/")} class="logo"><img src={url("/logo.svg?v=5")} alt="" width="30" height="30" />Helena Nguyen<span>.</span></a>
      <nav aria-label="Main">
        {nav.map((item) => (
          <a href={url(item.href)} aria-current={path.startsWith(url(item.href)) ? 'page' : undefined}>{item.label}</a>
        ))}
        <a href={url("/resume.pdf")} target="_blank" rel="noopener">Resume</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer wrap">
      <p>© {new Date().getFullYear()} Helena Nguyen</p>
      <p>
        <a href="mailto:you@example.com">Email</a> ·
        <a href="https://www.linkedin.com/" target="_blank" rel="noopener">LinkedIn</a>
      </p>
    </footer>
  </body>
</html>
<style>
  .site-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding-top: 24px; padding-bottom: 24px; }
  .logo { font-family: var(--font-display); font-size: 20px; font-weight: 500; text-decoration: none; display: inline-flex; align-items: center; }
  .logo img { display: block; width: 30px; height: 30px; margin-right: 10px; }
  .logo span { color: var(--accent); }
  nav { display: flex; gap: clamp(14px, 3vw, 28px); }
  nav a { text-decoration: none; color: var(--muted); font-size: 15px; transition: color .2s; }
  nav a:hover, nav a[aria-current='page'] { color: var(--text); }
  main { min-height: 70vh; }
  .site-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; border-top: 1px solid var(--line); margin-top: 96px; padding-top: 24px; padding-bottom: 40px; color: var(--muted); font-size: 14px; }
</style>
