---
import { url } from '../lib/url';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title, description = 'Portfolio of Helena Nguyen, product manager and data analyst.' } = Astro.props;
const pageTitle = title ? `${title} · Helena Nguyen` : 'Helena Nguyen';
const path = Astro.url.pathname;
const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header wrap">
      <a href={url("/")} class="logo">Helena Nguyen<span>.</span></a>
      <nav aria-label="Main">
        {nav.map((item) => (
          <a href={url(item.href)} aria-current={path.startsWith(url(item.href)) ? 'page' : undefined}>{item.label}</a>
        ))}
        <a href={url("/resume.pdf")} target="_blank" rel="noopener">Resume</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer wrap">
      <p>© {new Date().getFullYear()} Helena Nguyen</p>
      <p>
        <a href="mailto:you@example.com">Email</a> ·
        <a href="https://www.linkedin.com/" target="_blank" rel="noopener">LinkedIn</a>
      </p>
    </footer>
  </body>
</html>
<style>
  .site-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding-top: 24px; padding-bottom: 24px; }
  .logo { font-family: var(--font-display); font-size: 22px; font-weight: 600; text-decoration: none; }
  .logo span { color: var(--accent); }
  nav { display: flex; gap: clamp(14px, 3vw, 28px); }
  nav a { text-decoration: none; color: var(--muted); font-size: 15px; transition: color .2s; }
  nav a:hover, nav a[aria-current='page'] { color: var(--text); }
  main { min-height: 70vh; }
  .site-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; border-top: 1px solid var(--line); margin-top: 96px; padding-top: 24px; padding-bottom: 40px; color: var(--muted); font-size: 14px; }
</style>
