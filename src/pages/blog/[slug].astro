---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags } = post.data;
const fmt = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={title} description={description}>
  <article class="wrap">
    <a class="back" href={url('/blog/')}>← All posts</a>
    <header>
      <time datetime={date.toISOString()}>{fmt}</time>
      <h1>{title}</h1>
      {tags.length > 0 && <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>}
    </header>
    <div class="body"><Content /></div>
  </article>
</Base>
<style>
  .back { display: inline-block; margin-top: 32px; color: var(--muted); text-decoration: none; font-size: 15px; }
  header { margin: 32px 0 40px; max-width: 760px; }
  time { font-size: 14px; color: var(--muted); }
  .tags { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { font-size: 13px; color: var(--muted); border: 1px solid var(--line); background: var(--surface); border-radius: 999px; padding: 5px 14px; }
  h1 { font-size: clamp(30px, 4.2vw, 48px); font-weight: 300; margin: 10px 0; }
  .body { max-width: 68ch; font-size: 18px; }
  .body :global(h2) { font-size: 28px; margin-top: 40px; }
  .body :global(h2) { font-weight: 300; }
  .body :global(li) { margin-bottom: 10px; }
  .body :global(li strong), .body :global(p strong) { font-weight: 600; }
  .body :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; margin: 28px 0; display: block; overflow-x: auto; }
  .body :global(th) { text-align: left; font-weight: 600; padding: 10px 14px 10px 0; border-bottom: 1px solid var(--muted); vertical-align: bottom; }
  .body :global(td) { padding: 14px 14px 14px 0; border-bottom: 1px solid var(--line); vertical-align: top; line-height: 1.5; }
  .body :global(td:first-child) { font-weight: 600; white-space: nowrap; }
  .body :global(a) { color: inherit; text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .body :global(code) { font-size: 0.9em; background: var(--surface); border: 1px solid var(--line); padding: 1px 6px; border-radius: 6px; }
</style>
