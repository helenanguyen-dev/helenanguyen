---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags } = post.data;
const fmt = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={title} description={description}>
  <article class="wrap">
    <a class="back" href={url('/blog/')}>← All posts</a>
    <header>
      <time datetime={date.toISOString()}>{fmt}</time>
      <h1>{title}</h1>
      {tags.length > 0 && <p class="tags">{tags.join(' · ')}</p>}
    </header>
    <div class="body"><Content /></div>
  </article>
</Base>
<style>
  .back { display: inline-block; margin-top: 32px; color: var(--muted); text-decoration: none; font-size: 15px; }
  header { margin: 32px 0 40px; max-width: 760px; }
  time, .tags { font-size: 14px; color: var(--muted); }
  h1 { font-size: clamp(30px, 4.2vw, 48px); font-weight: 300; margin: 10px 0; }
  .body { max-width: 68ch; font-size: 18px; }
  .body :global(h2) { font-size: 28px; margin-top: 40px; }
  .body :global(code) { font-size: 0.9em; background: var(--surface); border: 1px solid var(--line); padding: 1px 6px; border-radius: 6px; }
</style>
