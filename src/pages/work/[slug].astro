---
import { url } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, role, year, tags, cover, coverAlt } = project.data;
---
<Base title={title} description={summary}>
  <article class="wrap">
    <a class="back" href={url("/work/")}>← All work</a>
    <h1>{title}</h1>
    <p class="lead">{summary}</p>
    <dl class="facts">
      <div><dt>Role</dt><dd>{role}</dd></div>
      <div><dt>Year</dt><dd>{year}</dd></div>
      <div><dt>Focus</dt><dd>{tags.join(', ')}</dd></div>
    </dl>
    {cover ? <Image class="cover cover-img" src={cover} alt={coverAlt ?? ''} widths={[800, 1400, 2000]} sizes="(max-width: 1120px) 100vw, 1080px" /> : <div class="placeholder cover">Cover image</div>}
    <div class="body"><Content /></div>
  </article>
</Base>
<style>
  .back { display: inline-block; margin-top: 32px; color: var(--muted); text-decoration: none; font-size: 15px; }
  h1 { font-size: clamp(30px, 4.2vw, 48px); font-weight: 300; margin: 24px 0 16px; max-width: 18ch; }
  .lead { font-size: 21px; color: var(--muted); max-width: 55ch; }
  .facts { display: flex; flex-wrap: wrap; gap: 40px; margin: 32px 0; padding: 24px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  dt { font-size: 13px; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
  dd { margin: 4px 0 0; }
  .cover { aspect-ratio: 16 / 9; margin-bottom: 48px; }
  .cover-img { width: 100%; height: auto; aspect-ratio: auto; border-radius: var(--radius); border: 1px solid var(--line); }
  .body { max-width: 68ch; }
  .body :global(h2) { font-size: 30px; margin-top: 48px; }
  .body :global(table) { width: 100%; border-collapse: collapse; margin: 24px 0; font-size: 16px; display: block; overflow-x: auto; }
  .body :global(th), .body :global(td) { text-align: left; padding: 10px 14px 10px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .body :global(th) { font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); font-weight: 500; }
  .body :global(blockquote) { border-left: 3px solid var(--accent); margin: 24px 0; padding-left: 20px; color: var(--muted); }
</style>
